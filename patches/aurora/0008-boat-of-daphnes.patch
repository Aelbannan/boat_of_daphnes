+
+// Recreates the frame buffers larger once every frame in flight is done with them.
+void grow_frame_buffers() {
+  ZoneScoped;
+  render_worker::synchronize();
+  // Each submitted frame maps its staging buffer again asynchronously; wait for all of them.
+  for (size_t slot = 0; slot < g_stagingBuffers.size(); ++slot) {
+    while (g_mappingStates[slot].load(std::memory_order_acquire) == BufferMapState::Mapping) {
+      wait_for_gpu_progress(std::chrono::microseconds{100});
+    }
+  }
+  auto& res = g_resources;
+  // Within the device's limits: vertex and storage buffers are also bound as storage, and the
+  // staging buffer holds all of them at once.
+  const uint64_t maxBuffer = res.limits.maxBufferSize;
+  const uint64_t maxStorage = std::min<uint64_t>(maxBuffer, res.limits.maxStorageBufferBindingSize);
+  const auto grow = [&](std::atomic<uint64_t>& request, uint64_t& size, uint64_t limit) {
+    const uint64_t needed = request.exchange(0, std::memory_order_acq_rel);
+    if (needed <= size) {
+      return;
+    }
+    const uint64_t others = staging_layout().size - size;
+    limit = std::min(limit, maxBuffer > others ? maxBuffer - others : 0);
+    const uint64_t newSize = std::min(grown_size(size, needed), limit & ~uint64_t{255});
+    if (newSize <= size) {
+      Log.warn("Frame buffer cannot grow past {} bytes (device limit); oversized frames stay cut short", size);
+      return;
+    }
+    size = newSize;
+  };
+  const uint64_t oldVerts = res.vertexBufferSize, oldIndices = res.indexBufferSize, oldStorage = res.storageBufferSize;
+  grow(g_growVerts, res.vertexBufferSize, maxStorage);
+  grow(g_growIndices, res.indexBufferSize, maxBuffer);
+  grow(g_growStorage, res.storageBufferSize, maxStorage);
+  if (res.vertexBufferSize == oldVerts && res.indexBufferSize == oldIndices && res.storageBufferSize == oldStorage) {
+    return;
+  }
+  Log.warn("Growing frame buffers: vertex {} -> {}, index {} -> {}, storage {} -> {} bytes", oldVerts,
+           res.vertexBufferSize, oldIndices, res.indexBufferSize, oldStorage, res.storageBufferSize);
+  create_frame_buffers();
+  create_static_bind_group();
+  for (size_t slot = 0; slot < g_stagingBuffers.size(); ++slot) {
+    g_mappingStates[slot].store(BufferMapState::Unmapped, std::memory_order_release);
+    map_staging_buffer(slot);
+  }
+}
