+
+// Textures whose pixels change every frame (Boat of Daphnes' fork: its in-app GBA's screen).
+namespace {
+struct DynamicTexture {
+  wgpu::Texture texture;
+  uint32_t width = 0;
+  uint32_t height = 0;
+  SDL_Texture* sdl = nullptr;
+};
+std::mutex g_dynamicTexturesMutex;
+std::unordered_map<ImTextureID, DynamicTexture> g_dynamicTextures;
+} // namespace
+
+ImTextureID create_dynamic_texture(uint32_t width, uint32_t height) noexcept {
+  if (SDL_Renderer* renderer = window::get_sdl_renderer()) {
+    SDL_Texture* texture = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_RGBA32, SDL_TEXTUREACCESS_STREAMING, width, height);
+    SDL_SetTextureScaleMode(texture, SDL_SCALEMODE_LINEAR);
+    g_sdlTextures.push_back(texture);
+    const auto id = reinterpret_cast<ImTextureID>(texture);
+    std::lock_guard lock{g_dynamicTexturesMutex};
+    g_dynamicTextures[id] = DynamicTexture{{}, width, height, texture};
+    return id;
+  }
+  const wgpu::Extent3D size{.width = width, .height = height, .depthOrArrayLayers = 1};
+  const wgpu::TextureDescriptor textureDescriptor{
+      .label = "imgui dynamic texture",
+      .usage = wgpu::TextureUsage::TextureBinding | wgpu::TextureUsage::CopyDst,
+      .dimension = wgpu::TextureDimension::e2D,
+      .size = size,
+      .format = wgpu::TextureFormat::RGBA8Unorm,
+      .mipLevelCount = 1,
+      .sampleCount = 1,
+  };
+  const wgpu::TextureViewDescriptor textureViewDescriptor{
+      .label = "imgui dynamic texture view",
+      .format = wgpu::TextureFormat::RGBA8Unorm,
+      .dimension = wgpu::TextureViewDimension::e2D,
+      .mipLevelCount = WGPU_MIP_LEVEL_COUNT_UNDEFINED,
+      .arrayLayerCount = WGPU_ARRAY_LAYER_COUNT_UNDEFINED,
+  };
+  auto texture = webgpu::g_device.CreateTexture(&textureDescriptor);
+  auto textureView = texture.CreateView(&textureViewDescriptor);
+  const auto id = reinterpret_cast<ImTextureID>(textureView.MoveToCHandle());
+  g_wgpuTextures.push_back(texture);
+  std::lock_guard lock{g_dynamicTexturesMutex};
+  g_dynamicTextures[id] = DynamicTexture{texture, width, height, nullptr};
+  return id;
+}
+
+void update_texture(ImTextureID id, const uint8_t* rgba) noexcept {
+  DynamicTexture d;
+  {
+    std::lock_guard lock{g_dynamicTexturesMutex};
+    const auto it = g_dynamicTextures.find(id);
+    if (it == g_dynamicTextures.end()) {
+      return;
+    }
+    d = it->second;
+  }
+  if (d.sdl != nullptr) {
+    SDL_UpdateTexture(d.sdl, nullptr, rgba, static_cast<int>(d.width * 4));
+    return;
+  }
+  auto bytes = std::make_shared<std::vector<uint8_t>>(rgba, rgba + static_cast<size_t>(d.width) * d.height * 4);
+  gfx::render_worker::enqueue_work([texture = d.texture, bytes, width = d.width, height = d.height] {
+    const wgpu::TexelCopyTextureInfo dst{.texture = texture};
+    const wgpu::TexelCopyBufferLayout layout{.bytesPerRow = width * 4, .rowsPerImage = height};
+    const wgpu::Extent3D size{.width = width, .height = height, .depthOrArrayLayers = 1};
+    webgpu::g_queue.WriteTexture(&dst, bytes->data(), bytes->size(), &layout, &size);
+  });
+}
